{
  "manifest_version": 3,
  "name": "Guidia Anywhere Screenshot Assistant",
  "version": "0.1.0",
  "description": "Ask Guidia to explain the visible screen on supported websites.",
  "permissions": ["activeTab", "tabs", "storage"],
  "host_permissions": ["http://localhost:8000/*", "http://localhost:5173/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Ask Guidia about this page"
  }
}
