# Copy to backend/.env and fill in real values. Never commit backend/.env.
# Nothing here may be exposed to the frontend — never prefix with VITE_.

NODE_ENV=development
PORT=8000
# Comma-separated list of web origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173
# Public URL of the web app (used in emails and extension pairing links).
APP_URL=http://localhost:5173
# Comma-separated Chrome/Edge extension IDs allowed to call the API.
# Leave empty to block all extensions.
ALLOWED_EXTENSION_IDS=
# Refresh-cookie SameSite policy: "lax" when web app and API share a site,
# "none" when they are on different sites (requires HTTPS).
COOKIE_SAMESITE=lax

# ── Database (SQLite) ────────────────────────────────────────────────────
# A single file created next to prisma/schema.prisma. No server or Docker.
DATABASE_URL="file:./guidia.db"

# ── Auth ─────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── AI ───────────────────────────────────────────────────────────────────
# Main provider: gemini (free tier, needs GEMINI_API_KEY) · ollama (free,
# runs on this computer, no key) · xai (paid) · none.
# Fallback: tried automatically if the main provider fails or hits its
# free daily limit. See docs/FREE_AI_SETUP.md.
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=ollama

# Google Gemini — free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Used automatically when the main model is busy or rate-limited.
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Backup voice only: Gemini's free tier allows ~10 spoken clips a day.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# Spoken guidance ("Listen" buttons). Default "edge": free natural neural
# voices (the ones Microsoft Edge's Read aloud uses) — no key, no quota.
# Clips are cached in backend/.tts-cache. Options: edge · gemini · off
SPEECH_PROVIDER=edge
SPEECH_VOICE_BN=bn-IN-TanishaaNeural
SPEECH_VOICE_HI=hi-IN-MadhurNeural
SPEECH_VOICE_VI=vi-VN-HoaiMyNeural
SPEECH_VOICE_EN=en-US-AvaNeural

# Ollama — install from https://ollama.com, then: ollama pull gemma3:4b
# (or qwen2.5vl:7b on a 16 GB+ machine for better screenshot reading)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma3:4b
# Time limit (ms) for the local model, so nobody waits minutes on a slow computer.
OLLAMA_TIMEOUT_MS=45000

# xAI / Grok (paid, optional; also provides Guidia's server voice)
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_TTS_MODEL=
XAI_STT_MODEL=

AI_TIMEOUT_MS=30000
# A scam check never waits longer than this for the AI's extra opinion;
# the rule-based verdict is shown on its own after it (milliseconds).
SAFETY_AI_BUDGET_MS=12000
AI_MAX_RETRIES=0

# ── ML service (Hugging Face models behind FastAPI) ──────────────────────
ML_SERVICE_URL=http://localhost:8001
ML_TIMEOUT_MS=3000
HF_MODEL_INTENT=guidia-intent-xlm-r
HF_MODEL_SAFETY=guidia-safety-xlm-r
HF_EMBEDDING_MODEL=
HF_API_TOKEN=
# Tune these from validation data (ml/README.md), don't guess.
INTENT_HIGH_CONFIDENCE_THRESHOLD=0.85
INTENT_LOW_CONFIDENCE_THRESHOLD=0.5

# ── Email (SMTP) ─────────────────────────────────────────────────────────
# Without SMTP_HOST, emails are recorded as SKIPPED — never reported as sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Guidia <no-reply@example.com>"

# ── Feature flags (true/false) ───────────────────────────────────────────
FEATURE_GROK_VISION=true
FEATURE_HF_INTENT=true
FEATURE_HF_SAFETY=true
FEATURE_RAG=true
FEATURE_REALTIME_VOICE=false
FEATURE_GUARDIAN_APPROVAL=true
FEATURE_BROWSER_EXTENSION=true
FEATURE_DEMO_MODE=true

# ── Kill switches (true disables the capability immediately) ─────────────
DISABLE_AI_CHAT=false
DISABLE_AI_VISION=false
DISABLE_VOICE=false
DISABLE_SENSITIVE_ACTIONS=false

# ── Workers ──────────────────────────────────────────────────────────────
WORKER_ENABLED=true
WORKER_INTERVAL_MS=5000

# ─── Free AI chain (added 2026-10-08) ───────────────────────────────────────
# Providers are tried in this order; when one runs out of free quota the
# next one answers. Leave a provider's keys empty to skip it.
AI_CHAIN=gemini,groq,openrouter,ollama
# Extra free Gemini keys (each from a DIFFERENT Google account), comma separated:
#   https://aistudio.google.com/apikey
GEMINI_API_KEYS=
# Groq — free, very fast, reads screenshots too: https://console.groq.com/keys
GROQ_API_KEYS=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# OpenRouter — free ":free" models: https://openrouter.ai/settings/keys
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_VISION_MODEL=google/gemma-3-27b-it:free
