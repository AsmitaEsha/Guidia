# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env.

PORT=8000
NODE_ENV=development

# SQLite for local development. Point this at a Postgres URL in production.
DATABASE_URL="file:./dev.db"

# Origin(s) allowed to call this API (the Vite dev server by default).
CORS_ORIGIN=http://localhost:5173

# Secrets used to sign access/refresh tokens. Generate real random values —
# do not use these placeholders outside local development.
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# AI Gateway (see backend/src/ai/gateway.js). Never prefix these with VITE_ —
# they must only ever be read on the server.
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
