{
  "name": "guidia-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Guidia API — authentication, learning, practice, safety, guardian, memory, AI gateway.",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.js",
    "test": "node --test \"src/**/__tests__/*.test.js\"",
    "test:integration": "node scripts/test-integration.mjs",
    "db:setup": "prisma migrate deploy && node prisma/seed.js",
    "check": "node scripts/check-api.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "msedge-tts": "^2.0.9",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.13",
    "openai": "^5.23.2",
    "sharp": "^0.34.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^6.5.0",
    "supertest": "^7.3.1"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=20"
  }
}
